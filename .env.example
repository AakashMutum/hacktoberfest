# Which model provider the investigator and screenshot scan use:
# auto (default) tries ollama, then gemini, then openai_compat, then the labelled template.
LLM_PROVIDER=auto

# Local Gemma 4 through Ollama (open weights, runs on your machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Gemma 4 through the Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Any OpenAI-compatible endpoint (vLLM, llama.cpp server, LM Studio, hosted APIs)
LLM_BASE_URL=
LLM_MODEL=gemma-4
LLM_API_KEY=

# Seed for the synthetic data, model and replay
SEED=42
